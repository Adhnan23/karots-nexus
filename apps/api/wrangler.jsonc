{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karots-nexus-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Core D1 datastore. Run `wrangler d1 create karots-nexus` and paste the id here.
  // Migrations are generated by @karots/db into ../../packages/db/migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karots-nexus",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // KV cache for weather snapshots / computed recommendations.
  // Run `wrangler kv namespace create CACHE` and paste the id here.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
  // UPLOADTHING_TOKEN and ADMIN_TOKEN are secrets: .dev.vars locally,
  // `wrangler secret put` in prod. There are no user accounts — the public is
  // read-only; ADMIN_TOKEN gates all mutating routes.
}
